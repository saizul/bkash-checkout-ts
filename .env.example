# Sandbox credentials from your bKash merchant onboarding sheet.
# Never commit real values.
BKASH_ENV=sandbox
BKASH_USERNAME=your-merchant-username
BKASH_PASSWORD=your-merchant-password
BKASH_APP_KEY=your-app-key
BKASH_APP_SECRET=your-app-secret
# Optional: override the API host (proxy, or the host on your onboarding sheet)
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh
PUBLIC_BASE_URL=http://localhost:3000
